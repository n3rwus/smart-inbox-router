# --- notifier service (read inside the container) ---
NOTIFIER_FROM_ADDRESS=smart-inbox-router@example.com
NOTIFIER_LOG_LEVEL=INFO
NOTIFIER_LOG_JSON=true
NOTIFIER_SMTP__HOST=mailhog
NOTIFIER_SMTP__PORT=1025
NOTIFIER_SMTP__TIMEOUT_SECONDS=10
NOTIFIER_SMTP__START_TLS=false

# --- integration tests (set by docker-compose.test.yml, listed here for reference) ---
MAILHOG_API_URL=http://mailhog:8025/api
MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025

# --- notifier HTTP server ---
NOTIFIER_HTTP__HOST=0.0.0.0
NOTIFIER_HTTP__PORT=8000

# Copy to .env for local dev with `uv run router` / `uv run notifier`.
# Compose provides its own values via `environment:` blocks — this file is
# only used when a service runs on the host. Only user-tunable knobs live
# here: addresses of other services are hardcoded in compose.

# --- LLM model (shared by ollama-init and router-agent) ---
OLLAMA_MODEL=qwen2.5:3b

# --- router (host) ---
ROUTER_LOG_LEVEL=INFO
ROUTER_LOG_JSON=true
ROUTER_LLM__TIMEOUT_SECONDS=120
ROUTER_WORKER__POLL_INTERVAL_SECONDS=1
ROUTER_WORKER__MAX_ATTEMPTS=5

# --- notifier (host) ---
NOTIFIER_LOG_LEVEL=INFO
NOTIFIER_LOG_JSON=true
NOTIFIER_FROM_ADDRESS=smart-inbox-router@example.com
NOTIFIER_SMTP__TIMEOUT_SECONDS=10
NOTIFIER_SMTP__START_TLS=false
